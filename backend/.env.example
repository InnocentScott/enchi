# ===== Shared infra =====
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_MULTIPLE_DATABASES=auth_db,content_db,progress_db,srs_db

REDIS_URL=redis://redis:6379

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ===== Auth =====
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ===== Per-service DB DSN (host = container name) =====
AUTH_DATABASE_URL=postgres://app:app_password@postgres:5432/auth_db?sslmode=disable
CONTENT_DATABASE_URL=postgres://app:app_password@postgres:5432/content_db?schema=public
PROGRESS_DATABASE_URL=postgres://app:app_password@postgres:5432/progress_db?sslmode=disable
SRS_DATABASE_URL=postgres://app:app_password@postgres:5432/srs_db?sslmode=disable

# ===== Host port mapping (đổi nếu trùng cổng với project khác trên máy) =====
# Chỉ ảnh hưởng cổng publish ra host; giao tiếp nội bộ giữa container không đổi.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
GATEWAY_HOST_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# ===== Media (TTS provider chốt sau) =====
TTS_PROVIDER=stub            # stub | google | azure
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=language-app-audio
