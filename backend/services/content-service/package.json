{
  "name": "content-service",
  "version": "0.1.0",
  "description": "Content Service (NestJS) — courses, lessons, vocabulary, quizzes",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
